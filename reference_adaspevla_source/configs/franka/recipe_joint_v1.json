{
  "name": "FrankaBreadV11",
  "reference": "v1.1 bread only; same frozen pi05 6-language-layer architecture and training budget as joint v1",
  "task_names": [
    "bread"
  ],
  "chunk_horizon": 13,
  "num_control_points": 11,
  "degree": 3,
  "control_dt": 0.1,
  "min_query_interval": 0.2,
  "max_query_interval": 0.8,
  "action_steps": 40000,
  "timing_steps": 10000,
  "local_batch": 64,
  "world_size": 1,
  "seed": 0,
  "lr": 0.0002,
  "weight_decay": 0.0001,
  "gradient_clip": 1.0,
  "warmup_steps": 500,
  "save_every": 1000,
  "log_every": 50,
  "supervision": "measured_pose",
  "action_frame": "episode_reset",
  "split": "all100_bread_no_holdout",
  "pad_episode_end": true,
  "sampling": "uniform bread windows, with replacement",
  "status": "configured",
  "warmup_rule": "min(warmup_steps, stage_steps // 10)",
  "effective_warmup_steps": {
    "action": 500,
    "timing": 500
  }
}
